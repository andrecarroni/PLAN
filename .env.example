# Use python3 scripts/configure.py para criar .env com senha aleatória.
POSTGRES_PASSWORD=
APP_ENV=development
# Produção: APP_ENV=production, HTTPS no proxy e PostgreSQL.
# Sem Docker: DATABASE_URL é lida pelo processo backend.
# Logo: frontend/public/logo.png; opcional LOGO_PATH no servidor.
# Na nuvem: P4_PROXY_CA aponta para o certificado fornecido pelo proxy.
